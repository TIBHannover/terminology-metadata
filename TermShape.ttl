## ein paar worte zu den term-shapes im metadaten guide einbringen

# Term-level metadata

termmeta:TermShape rdf:type sh:NodeShape , owl:Ontology ;
  sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
  sh:closed false;

## Mandatory metadata

### 4.1.1 Preferred label - minCount

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.1 Preferred label - minCount"@en ;
    sh:severity sh:Violation ;
    sh:path [
      sh:alternativePath (
        rdfs:label
        skos:prefLabel
        dcterms:title
        dc:title
        schema:name
        gndo:preferredNameForTheSubjectHeading
        physh:prefLabel
      )
   ];
   sh:minCount 1 ;
   sh:message """The entity does not have a label. At least one preferred label is required. When you add a label, make sure to add it as an rdf:langString and to tag it with a language tag that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Please do this, even if you provide the ontology in one language only! Recommended property: <http://www.w3.org/2000/01/rdf-schema#label>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; rdfs:label "smart grid"@en ."""@en ;
  ];

### 4.1.1 Preferred label - datatype

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.1 Preferred label - datatype"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        rdfs:label
        skos:prefLabel
        dcterms:title
        dc:title
        schema:name
        gndo:preferredNameForTheSubjectHeading
        physh:prefLabel
      )
     ];
    sh:datatype rdf:langString ;
    sh:message """The entity's label is not an rdf:langString. Add a language tag to the label that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Recommended property: <http://www.w3.org/2000/01/rdf-schema#label>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; rdfs:label "smart grid"@en ."""@en ;
  ];

### 4.1.1 Preferred label - unique language

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.1 Preferred label - unique language"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        rdfs:label
        skos:prefLabel
        dcterms:title
        dc:title
        schema:name
        gndo:preferredNameForTheSubjectHeading
        physh:prefLabel
      )
    ];
    sh:uniqueLang true ;
    sh:message """The entity has more than one preferred label in the same language. There must be only one preferred label per language. Please check, if all labels carry the correct language tag. If there are several labels for the same entity, make sure to choose one as the preferred label and set the other as a synonym. (e.g. with skos:altLabel)."""@en ;
  ];


### 4.1.2 Definition - min Count

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.2 Definition - min Count"@en ;
    sh:severity sh:Violation ;
    sh:path [
      sh:alternativePath (
        skos:definition
        obo:IAO_0000115
        dcterms:description
        gndo:definition
        prov:definition
        dc:description
        oio:hasDefinition
        emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84
      )
    ];
    sh:minCount 1;
    sh:message """The entity is not defined. A definition must be added. There must only be one definition per language. The definition must be an intensional definition (see also <https://en.wikipedia.org/wiki/Extensional_and_intensional_definitions#Intensional_definition>). Recommended property: <http://www.w3.org/2004/02/skos/core#definition>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; skos:definition "electrical grid with information and communication technology as well as automation mechanisms that includes a great number of decentralized electrical energy sources"@en ."""@en ;
  ];

### 4.1.2 Definition - datatype

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.2 Definition - datatype"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        skos:definition
        obo:IAO_0000115
        dcterms:description
        gndo:definition
        prov:definition
        dc:description
        oio:hasDefinition
        emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84
      )
    ];
    sh:datatype rdf:langString ;
    sh:message """The entity's definition is not an rdf:langString. Add a language tag to the definition that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; skos:definition "electrical grid with information and communication technology as well as automation mechanisms that includes a great number of decentralized electrical energy sources"@en ."""@en ;
  ] ;

### 4.1.2 Definition - unique language

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.2 Definition - unique language"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        skos:definition
        obo:IAO_0000115
        dcterms:description
        gndo:definition
        prov:definition
        dc:description
        oio:hasDefinition
        emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84
      )
    ];
    sh:uniqueLang true ;
    sh:message """The entity has more than one definition in the same language. There must be only one definition per language. Please check, if all definitions carry the correct language tag. If there are several definitions for the same entity, make sure to choose only one that is adequate to describe the entity."""@en ;
  ];

##### 4.1.2.1 Definition source

# we offer a range of possibilities to provide definition sources - would require several shapes
# requires the introduction of subclasses of owl:Axiom > the owl:Axioms are seperate, anonymous entities and cannot be selected via sh:path > cannot be part of the TermShape
# see termmeta:DefinitionSourceAxiomShapeStyle1, termmeta:DefinitionSourceAxiomShapeStyle2 and termmeta:DefinitionSourceAxiomShapeStyle3and4

### 4.1.3 Term deprecation/ obsoletion (mandatory only if applicable!)

### 4.1.3.1 Deprecation marker (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.3.1 Deprecation marker (mandatory only if applicable!)"@en ;
    sh:severity sh:Info ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:maxCount 1 ;
    sh:message """There is more than one deprecation marker for the entity. There must only be one. Recommended property: <http://www.w3.org/2002/07/owl#deprecated>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; owl:deprecated true ."""@en
  ];

### 4.1.3.2 Obsoletion reason (mandatory only if applicable!)
# does not trigger anything, even if value is not in list, check whether sh:in is properly applied! > was not declared as an sh:PropertyShape > test again

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.3.2 Obsoletion reason (mandatory only if applicable!)"@en ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0000231 ;
    sh:nodeKind sh:IRI ; # eigenständige shape machen? oder passt eher so...
    sh:minCount 0 ; # mandatory only if applicable, minimal requirements is that it is one of the list items
    sh:in (
      obo:IAO_0000103
      obo:IAO_0000226
      obo:IAO_0000228
      obo:IAO_0000229
      obo:IAO_0000227
      obo:OMO_0001000
    );
    sh:message """The value for \"obsoletion reason\" is not in the recommended list of values. These are: [failed exploratory term](http://purl.obolibrary.org/obo/IAO_0000103), [placeholder removed](http://purl.obolibrary.org/obo/IAO_0000226), [term imported](http://purl.obolibrary.org/obo/IAO_0000228), [term split](http://purl.obolibrary.org/obo/IAO_0000229), [terms merged](http://purl.obolibrary.org/obo/IAO_0000227), [out of scope](http://purl.obolibrary.org/obo/OMO_0001000). Please select an appropriate obsolesence reason and provide it as an IRI. Recommended property: \'has obsolescence reason\' <http://purl.obolibrary.org/obo/IAO_0000231>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; obo:IAO_0000231 <http://purl.obolibrary.org/obo/IAO_0000103>."""@en ;
  ];

### 4.1.3.3 Term replacement (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.1.3.3 Term replacement (mandatory only if applicable!)"@en ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0100001 ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:message """The replacement term must be provdided as an IRI. Please check if it was provided in another format. If so, please make sure to reference the replacement term with its identifier. Recommended property: \'term replaced by\' <http://purl.obolibrary.org/obo/IAO_0100001)>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; obo:IAO_0100001 <https://www.purl.org/SomeOtherOntologyClass>."""@en
  ];

## 4.2 Recommended metadata

### 4.2.1 Synonyms/ alternative labels

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.2.1 Synonyms/ alternative labels"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        skos:altLabel
        oio:hasExactSynonym
        obo:IAO_0000118
      )
    ];
    sh:datatype rdf:langString ;
    sh:message """The synonym should be an rdf:langString. You should add a language tag to the comment that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Recommended property: <http://www.w3.org/2004/02/skos/core#altLabel>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; skos:altLabel "intelligent grid"@en ."""@en ;
  ];

### 4.2.2 Date modified
# can i combine the current naming pattern with this alternative naming pattern? Term metadata - date modified (recommended)
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.2.2 Date modified"@en ;
    sh:severity sh:Warning ;
    sh:path dcterms:modified ;
    sh:minCount 1 ; # we recommend it and I would expect it on every item, so the aim of this constraint is to trigger a message at least to raise awareness
    sh:message """You should provide the date on which the term has last been modified. Please provide the date as xsd:date, xsd:dateTime or xsd:dateTimeStamp. Recommended property: <http://purl.org/dc/terms/modified>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; dcterms:modified "2025-04-15T10:13:00"^^xsd:dateTime ."""@en
  ];

### 4.2.2 Date modified - datatype

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.2.2 Date modified - datatype"@en ;
    sh:severity sh:Warning ;
    sh:path dcterms:modified ;
    sh:xone (
      [sh:datatype xsd:date ;]
      [sh:datatype xsd:dateTime ;]
      [sh:datatype xsd:dateTimeStamp ;]
    );
    sh:message """The date modified of the term is not provided as an xsd:date, an xsd:dateTime or xsd:dateTimeStamp. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; dcterms:modified "2025-04-15T10:13:00"^^xsd:dateTime ."""@en
  ];

#### 4.2.3 Editor note

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.2.3 Editor note"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        skos:editorialNote
        obo:IAO_0000116
      )
    ];
    sh:datatype rdf:langString ;
    sh:message """The editor note is not provided as an rdf:langString. You should add a language tag to the comment that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Recommended property: <http://www.w3.org/2004/02/skos/core#editorialNote>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; skos:editorialNote "[2025-04-17T14:26:00][https://orcid.org/0000-0002-1584-4316] The class should be deprecated."@en ."""@en ;
  ] ;

#### 4.2.4 Term tracker item - datatype

# I would not necessarily expect a term tracker item for every term, so I did not add a minCoun 1 constraint with severity sh:Info
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ; 
    sh:name "4.2.4 Term tracker item - datatype"@en ;
    sh:path [
      sh:alternativePath (
        obo:IAO_0000233
        prov:wasDerivedFrom
        dcterms:source
      )
    ] ;
    sh:nodeKind sh:IRI ;
    sh:message """The term tracker item should be provided as an IRI. If the term was discussed on an issue tracker, you should provide the link to that issue, in particular any parts of the conversation, that were decisive for the final definition of the term. If the term was derived from another ontology, you should link to the respective term identifier. If the term and its definition was mainly informed by a domain expert, you should provide their ORCID. If the term and its definition are based on a scholarly publication, you should provide the DOI. Recommended property: \'term tracker item\' <http://purl.obolibrary.org/obo/IAO_0000233>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; obo:IAO_0000233 <https://github.com/SomeOrganisation/SomeOntology/issues#12>"""@en ;
  ];

## 4.3 Optional metadata

#### 4.3.1 Term editor/ term contributor(s)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "Term editor / term contributors - data type"@en ;
    sh:severity sh:Warning ;
    sh:path [
      sh:alternativePath (
        dcterms:contributor
        dc:contributor
        schema:contributor
      )
    ] ;
    sh:nodeKind sh:IRI ;
    sh:message """The term editor should be provided as an IRI, e.g. an Orcid, GND or Wikidata item may be used. Recommended property: <http://purl.org/dc/terms/contributor>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; dcterms:contributor <https://orcid.org/0000-0002-1584-4316> ."""@en ;
  ];

#### 4.3.2 Example of usage

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ;
    sh:name "example of usage - data type"@en ;
    sh:path [
      sh:alternativePath (
        obo:IAO_0000112
        skos:example
        vann:example
      )
    ];
    sh:xone (
      [sh:datatype rdf:langString ;]
      [sh:nodeKind sh:IRI]
    ) ;
    sh:message """The example of usage should either be given as an rdf:langString or as an IRI pointing to an external source, where the application examples is discussed or demonstrated in detail. Recommended property: \\'example of usage\\' <http://purl.obolibrary.org/obo/IAO_0000112>. Example (text/turtle): <http://purl.obolibrary.org/obo/VIBSO_0000020> rdf:type owl:Class ; obo:IAO_0000115 "A setting datum that specifies the height (length in the Y direction) of the region of interest."@en ; obo:IAO_0000112 "0.5 mm"@en ."""@en ;
  ];

#### 4.3.3 Defined by - data type

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ;
    sh:name "4.3.3 Defined by - data type"@en ;
    sh:path <http://www.w3.org/2000/01/rdf-schema#isDefinedBy>;
    sh:nodeKind sh:IRI ;
    sh:message """The value provided with rdfs:isDefinedBy should be provided as an IRI. We expect an ontology IRI here, so you should provide the canonocial identifier of an ontology. To achieve maximum precision and traceability, we recommend to provide the version IRI of the ontology a term has been taken from. Recommended property: <http://www.w3.org/2000/01/rdf-schema#isDefinedBy>. Example (text/turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:CLass ; rdfs:isDefinedBy <https://www.purl.org/SomeOntology> ."""@en ;
  ];


#### 4.3.4 Comments - datatype

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "4.3.4 Comments - datatype"@en ;
    sh:severity sh:Warning ;
    sh:path rdfs:comment ;
    sh:datatype rdf:langString ;
    sh:message """The comment is not an rdf:langString. You should add a language tag to the comment that conforms to <http://id.loc.gov/vocabulary/iso639-2>. Recommended property: <http://www.w3.org/2000/01/rdf-schema#comment>. Example (text/ turtle): <https://www.purl.org/SomeOntologyClass> rdf:type owl:Class ; rdfs:comment "a comment on this class"@en."""@en ;
  ]
.

##### 4.1.2.1 Definition source

## TODOS
# noch in den metadataguide einbauen
# macht sh:node hier sinn?
# alternative path for sh:targetSubjectsOf? > only with props specific for defs!

# we offer a range of possibilities to provide definition sources; these need to be seperate node shapes

## Style 1 with 'definition source' <http://purl.obolibrary.org/obo/IAO_0000119> + DOI

termmeta:DefinitionSourceAxiomShapeStyle1 a sh:NodeShape ;
    sh:targetSubjectsOf skos:definition ; # Will pick entities that are the subject of statements with  skos:definition as the node whose statements will be validated against the property shapes
    sh:closed false ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource  # selects a blank node that is subject of the owl:annotatedSource property
        ] ;
        rdfs:label "annotated source" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ; 
        sh:class owl:Axiom ; # the selected node must be an owl:Axiom
        sh:description "Each entitity that is defined with skos:definition must have at least one owl:Axiom providing the source of the definition."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        rdfs:label "annotaetd property"@en ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        # the selected node that is an owl:Axiom must have a statement about its owl:annotatedProperty; the object value must be skos:definition
        sh:property [
            sh:path owl:annotatedProperty ;
            sh:hasValue skos:definition ;
            sh:description "An owl:Axiom on entities that are defined with skos:defintion must have an owl:annotatedProperty (which is skos:definition)."@en
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # the selected node must have at least one statement declaring the annotated target, i.e. the definition of the entitiy 
        sh:property [
            sh:path owl:annotatedTarget;
            sh:minCount 1;
            sh:description "An owl:Axiom on entities that are defined with skos:definition must have an owl:annotatedTarget."
        ];
        sh:maxCount 1 ;
        rdfs:label "annotated target"@en ;
    ];
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # our style 1 recommends to use obo:IAO_0000119 as the property to declare the definitions's source; we want to see at least one source, more are also okay, if that applies
        sh:property [
            sh:path obo:IAO_0000119 ;
            sh:minCount 1 ;
            sh:description "In recommeded defintiony source style 1, the owl:Axiom must provide the definition source with \\'definition source\\' <http://purl.obolibrary.org/obo/IAO_0000119>."
        ] ;
        rdfs:label "definition source"@en ; 
    ] 
    .

## Style 2 using DCMI Metadata Terms 

termmeta:DefinitionSourceAxiomShapeStyle2 a sh:NodeShape ;
    sh:targetSubjectsOf skos:definition ; # Will pick entities that are the subject of statements with  skos:definition as the focus node on which the validation against the property shapes will be performed
    sh:closed false ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource  # selects a blank node that is subject of the owl:annotatedSource property
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ; 
        sh:class owl:Axiom ; # the selected node must be an owl:Axiom
        sh:description "Each entitity that is defined with skos:definition must have at least one owl:Axiom providing the source of the definition."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # the selected node that is an owl:Axiom must have a statement about its owl:annotatedProperty; the object value must be skos:definition
        sh:property [
            sh:path owl:annotatedProperty ;
            sh:hasValue skos:definition ;
            sh:description "An owl:Axiom on entities that are defined with skos:defintion must have an owl:annotatedProperty (which is skos:definition)."@en
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # the selected node must have at least one statement declaring the annotated target, i.e. the definition of the entitiy 
        sh:property [
            sh:path owl:annotatedTarget;
            sh:minCount 1;
            sh:description "An owl:Axiom on entities that are defined with skos:definition must have an owl:annotatedTarget."
        ]
    ];
        # our style 2 recommends to use various properties from DCMI Metadata Terms
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        sh:property [
            sh:path <http://purl.org/dc/terms/bibliographicCitation> ;
            sh:minCount 1 ;
            sh:datatype xsd:string ;
            sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/bibliographicCitation>. The object of that statement must be provided as an xsd:string."
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        sh:property [
            sh:path <http://purl.org/dc/terms/license> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/license>. The object of that statement must be provided as an sh:IRI."
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        sh:property [
            sh:path <http://purl.org/dc/terms/rightsHolder> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/rightsHolder>. The object of that statement must be provided as an sh:IRI, e.g. via a ROR identifier."
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        sh:property [
            sh:path <http://purl.org/dc/terms/source> ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/source>. The object of that statement must be provided as an sh:IRI, e.g. via a DOI."@en
        ]
    ] 
    . 

## Style 3 + 4 - using prov:hadPrimarySource + DOI or ORCID

### gemini
termmeta:DefinitionSourceAxiomShapeStyle3and4 a sh:NodeShape ;
    sh:targetSubjectsOf skos:definition ; # Will pick entities that are the subject of statements with  skos:definition as the focus node on which the validation against the property shapes will be performed
    sh:closed false ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource  # selects a blank node that is subject of the owl:annotatedSource property
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ; 
        sh:class owl:Axiom ;             # the selected node must be an owl:Axiom
        sh:description "Each entitity that is defined with skos:definition must have at least one owl:Axiom providing the source of the definition."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # the selected node that is an owl:Axiom must have a statement about its owl:annotatedProperty; the object value must be skos:definition
        sh:property [
            sh:path owl:annotatedProperty ;
            sh:hasValue skos:definition ;
            sh:description "An owl:Axiom on entities that are defined with skos:defintion must have an owl:annotatedProperty (which is skos:definition)."@en
        ]
    ] ;
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        # the selected node must have at least one statement declaring the annotated target, i.e. the definition of the entitiy
        sh:property [
            sh:path owl:annotatedTarget;
            sh:minCount 1;
            sh:description "An owl:Axiom on entities that are defined with skos:definition must have an owl:annotatedTarget."
        ]
    ];
        # our styles 3 and 4 recommends to provide the definition source using the property prov:hadPrimarySource; we require to provide at least one definition source; more are also okay if it is applicable  
    sh:property [
        sh:path [
            sh:inversePath owl:annotatedSource
        ] ;
        sh:property [
            sh:path prov:hadPrimarySource ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:description "The definition source axiom must have at least one statement with <http://www.w3.org/ns/prov#hadPrimarySource>. The source should be provided via an IRI, e.g. a DOI."@en 
        ]
    ] 
    .
