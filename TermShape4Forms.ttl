# Term-level metadata

# if used in ULB Darmstadt's <shacl-form demo> blank nodes will be the subject of all statements generated with this shape - these should be replaced by an identifier in ALL occurrences 

termmeta4forms: 
  rdf:type sh:NodeShape ;
  rdf:type owl:Ontology ;
  # owl:imports <http://www.w3.org/ns/shacl#> ; #when last imported (2024-04-05), SHACL was inconsistent
  dcterms:created "2025-06-30"^^xsd:date ;
  dcterms:modified "2025-06-30"^^xsd:date ;
  owl:versionIRI <https://purl.org/ontologymetadata/TermShape4Forms/20250630> ;
  owl:versionIRI <https://raw.githubusercontent.com/TIBHannover/terminology-metadata/refs/tags/20250630/TermShape4Forms.ttl> ;
  dcterms:title "SHACL Shape by TIB for generating term-level metadata of entities in ontologies."@en ;
  dcterms:title "SHACL Shape der TIB zur Generierung termbezogener Metadaten für Entitäten in Ontologien"@de ;
  dcterms:abstract "This shape is intended to be used in a form generator, e.g. the live demo tool of ULB Darmstadt at <https://ulb-darmstadt.github.io/shacl-form/#try-your-own>. The tool will generate a form from the SHACL specifciation in which users may enter metadata while the tool generates Turtle code from the user input and validates it at the same time. If you have any remarks, questions or suggestions get in touch with us at https://github.com/TIBHannover/terminology-metadata/issues"@en ;
  # This shape is intended to be used with .
  dcterms:license <https://creativecommons.org/licenses/by/4.0/legalcode>;
  dcterms:created "2024-06-30T00:00:00"^^xsd:dateTime;
  dcterms:modified "2025-06-30T00:00:00"^^xsd:dateTime;
  dcterms:creator <https://orcid.org/0000-0002-1019-9151> ;
  dcterms:creator <https://orcid.org/0000-0003-1043-4964> ;
  dcterms:creator <https://orcid.org/0000-0003-2499-7741> ;
  dcterms:creator <https://orcid.org/0000-0002-1595-3213> ;
  dcterms:creator <https://orcid.org/0000-0002-8280-0487> ;
  vann:preferredNamespacePrefix "termmeta4forms";
  doap:bug-database <https://github.com/TIBHannover/terminology-metadata/issues> ;
  premis:documentation <https://github.com/TIBHannover/terminology-metadata/blob/20250630/MetadataGuide.md> ;
  bibo:status "active"@en ;
  doap:audience "Ontology engineers, ontology publishers, terminology service providers, terminology service curators"@en;
  sdo:inLanguage <http://id.loc.gov/vocabulary/iso639-2/eng>;
  dcterms:subject <http://d-nb.info/gnd/4827894-4> ;
  dcterms:subject <http://d-nb.info/gnd/4410512-5> ;
  doap:repository <https://github.com/TIBHannover/terminology-metadata>;
  mod:hasSyntax <http://www.w3.org/ns/formats/Turtle> ;
  mod:hasFormalityLevel "RDF(S), OWL, SHACL"@en ;
  dcterms:references <https://doi.org/10.5281/zenodo.11103070> ;
  dcterms:bibliographicCitation "Arndt, S., Ganske, A., Hauschke, C., Strömert, P., & Vogt, L. (2024). Terminology Metadata Recommendations by TIB. Zenodo. https://doi.org/10.5281/zenodo.11103070 (latest version)" ;
  adms:versionNotes "The shape provides a first draft for a SHACL specification for term-level metadata to be used in a form generator."@en;
  mod:hasEquivalencesWith <https://github.com/TIBHannover/terminology-metadata/blob/20250630/MetadataGuide.md#45-relations-to-related-work>;
  sh:closed false;
;

## Mandatory metadata

# 4.1.0 Typing the entity - only needed for forms

 sh:property [
   a sh:PropertyShape ;
   sh:name "entity type"@en ;
   sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
   sh:path rdf:type ;
   sh:nodeKind sh:IRI ;
   sh:minCount 1 ;
   sh:in (
    owl:Class 
    owl:NamedIndividual 
    owl:ObjectProperty 
    owl:AnnotationProperty 
    owl:DatatypeProperty
  ) ;
    sh:group termmeta4forms:EntityTypeGroup ;
    sh:name "entity type"@en ;
    sh:description "The entity needs to be typed."@en ;
 ];

### 4.1.1 Preferred label

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "preferred label"@en ;
    sh:severity sh:Violation ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """The entity should have a label. The label should be the entity's preferred label. You should provide only one label per language. There may be a preferred label in each annotation language of the ontology, though."""@en ;
    sh:group termmeta4forms:LabelsGroup ;
  ];

### 4.1.2 Definition

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:name "definition"@en ;
    sh:severity sh:Violation ;
    sh:path skos:definition ;
    sh:minCount 1;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """The entity should be defined. The definition should be an intensional defintion. Please visit section 4.1.2 in the [metadata guide](<https://doi.org/10.5281/zenodo.11103070>) for more information about how to write a good definition. You will also find recommendations on how to provide sources for the definition in this chapter."""@en ;
    sh:group termmeta4forms:DefinitionGroup ;
  ];

# alternative to the shape directly above, do not want to use it for several reasons:
# (1) <shacl-form> demo will generate a statement with skos:definition and a blank node as its object
# (2) referencing the generated entity requires user to copypaste bnode id from generated code to form
# (3) since for the owl:Axiom a bnode like _:e45de023-010f-4c32-8d13-c38d02aa983c is generated, the definition is shown twice in the ontology - once readable with skos:definition and an annotation and once as an unreadable blank node ; to change this, the explicit definition statement needs to be removed to show this exactly as it would have been created with Protege
# (4) the code generated is not directly readable by Protege since the properties used are not  defined as annotationProperties and will not be displayed
# (5) all in all: too much work required afterwards to be explained by our recommendations > INSTEAD WE SHOULD RECOMMEND TO USE THE SHAPES FOR DEFINITION SOURCES SEPERATELY AFTER THE TERM SHAPE HAS BEEN USED
  # sh:property [
  #   rdf:type sh:PropertyShape ;
  #   sh:name "definition"@en ;
  #   sh:severity sh:Violation ;
  #   sh:path skos:definition ;
  #   sh:minCount 1;
  #   sh:node dss14forms ; 
  #   sh:description """The entity should be defined. The definition should be an intensional defintion. Please visit section 4.1.2 in the [metadata guide](<https://doi.org/10.5281/zenodo.11103070>) for more information about how to write a good definition. You will also find recommendations on how to provide sources for the definition in this chapter."""@en ;
  #   sh:group termmeta4forms:DefinitionGroup ;
  # ];

##### 4.1.2.1 Definition source

# we offer a range of possibilities to provide definition sources; these need to be seperate node shapes
# they can be used seperately in <shacl-form> demo to generate instances of owl:Axiom that refer to existing entities
# cf. DefinitionSourceAxiomShapeStyle14Forms.ttl, DefinitionSourceAxiomShapeStyle24Forms.ttl, DefinitionSourceAxiomShapeStyle3and44Forms.ttl

### 4.1.3 Term deprecation/ obsoletion (mandatory only if applicable!)

### 4.1.3.1 Deprecation marker (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:name "is deprecated"@en ;
    sh:severity sh:Info ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:maxCount 1 ;
    sh:group termmeta4forms:ObsoletionGroup ;
    sh:description """If the entitity shall be considered deprecated, please check the box."""@en
  ];

### 4.1.3.2 Obsoletion reason (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "obsoletion reason"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0000231 ;
    sh:nodeKind sh:IRI ;
    sh:group termmeta4forms:ObsoletionGroup ;
    sh:minCount 0 ; # mandatory only if applicable, minimal requirements is that it is one of the list items
    sh:in (
      <http://purl.obolibrary.org/obo/IAO_0000103>
      <http://purl.obolibrary.org/obo/IAO_0000226>
      <http://purl.obolibrary.org/obo/IAO_0000228>
      <http://purl.obolibrary.org/obo/IAO_0000229>
      <http://purl.obolibrary.org/obo/IAO_0000227>
      <http://purl.obolibrary.org/obo/OMO_0001000>
    );
    sh:description """If the entity was set to deprecated this field is mandatory. Please choose one of the list values to describe the reason for deprecating the entitiy. If none of them fit, you can also provide a deprecation reason with an rdfs:comment (see below)."""@en ;
  ];

### 4.1.3.3 Term replacement (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "replaced by"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0100001 ;
    sh:nodeKind sh:IRI ;
    sh:group termmeta4forms:ObsoletionGroup ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:description """If the entity is deprecated, please indicate if there is a replacement term that should be used instead."""@en
  ];

## 4.2 Recommended metadata

### 4.2.1 Synonyms/ alternative labels

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "synonyms/ alternative labels"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path skos:altLabel ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Add further labels for the entities - may include synonyms, short forms and other alternative signifiers of the entity. Please only add strict synonyms, i.e. labels that represent the same concept as the preferred label. Do not add near-synonyms or related terms."""@en ;
    sh:group termmeta4forms:LabelsGroup ;
  ];

### 4.2.2 Date modified

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "date modified"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path dcterms:modified ;
    sh:minCount 1 ; # we recommend it and I would expect it on every item, so the aim of this constraint is to trigger a message at least to raise awareness
    sh:datatype xsd:dateTime ;
    sh:description """Add the current date to indicate that the entity is modified today."""@en ;
    sh:group termmeta4forms:EditorialMetadataGroup ;
  ];

#### 4.2.3 Editor note

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "editor note"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path skos:editorialNote ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Add an editorial note, e.g. stating an open task to finalize the description of the entity."""@en ;
    sh:group termmeta4forms:EditorialMetadataGroup ;
  ] ;

#### 4.2.4 Term tracker item - datatype

# I would not necessarily expect a term tracker item for every term, so I did not add a minCoun 1 constraint with severity sh:Info
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ; 
    sh:name "term tracker item"@en ;
    sh:path obo:IAO_0000233 ;
    sh:nodeKind sh:IRI ;
    sh:description """Indicate a place where the entity is discussed and where new suggestions for its development can be made."""@en ;
    sh:group termmeta4forms:EditorialMetadataGroup ;
  ];

## 4.3 Optional metadata

#### 4.3.1 Term editor/ term contributor(s)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "term editor / term contributors"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path dcterms:contributor ;
    sh:nodeKind sh:IRI ;
    sh:description """Provide all term contributors via their Orcid. If no Orcid is available, try alternative identifiers like GND, Wikidata, or other scientific identification systems."""@en ;
    sh:group termmeta4forms:EditorialMetadataGroup ;
  ];

#### 4.3.2 Example of usage
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:name "example of usage"@en ;
    sh:path obo:IAO_0000112 ;
    sh:datatype rdf:langString ; # I'd prefer using text - could still be an iri as value
    sh:minCount 0 ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Describe how the entity can be applied. If the usage example is too complex, point to a paper or documentation for further discussion."""@en ;
    sh:group termmeta4forms:OtherTermAnnotationsShape ;
  ];

# in a shape to be used with ULB Darmstadts form generator, I cannot use both > both shapes will validate each other invalid, and the sh:xone construct is not supported in a way that users can decide which data type to use and what to evaluate as valid afaik
#   sh:property [
#     rdf:type sh:PropertyShape ;
#     sh:severity sh:Warning ;
#     sh:name "example of usage - IRI"@en ;
#     sh:path obo:IAO_0000112 ;
#     sh:minCount 0 ;
#     sh:nodeKind sh:IRI ;
#     sh:description """"""@en ;
#   ];

#### 4.3.3 Defined by

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:name "defined by"@en ;
    sh:path <http://www.w3.org/2000/01/rdf-schema#isDefinedBy>;
    sh:nodeKind sh:IRI ;
    sh:description """State the IRI of the ontology that defines the entity. The field can be repeated. For maximum precision, state both the canonical IRI of the defining ontology and its version IRI."""@en ;
    sh:group termmeta4forms:EditorialMetadataGroup ;
  ];


#### 4.3.4 Comments

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "comments"@en ;
    sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
    sh:severity sh:Warning ;
    sh:path rdfs:comment ;
    sh:datatype rdf:langString ;
    sh:description """Repeatable field to add any further comments on the entity."""@en ;
    sh:languageIn ("de" "en" "fr") ;
    sh:group termmeta4forms:OtherTermAnnotationsShape ;
  ]
.

#### Labels for list values

<http://purl.obolibrary.org/obo/IAO_0000103> rdfs:label "failed exploratory term (IAO_0000103)"@en .
<http://purl.obolibrary.org/obo/IAO_0000226> rdfs:label "placeholder removed (IAO_0000226)"@en .
<http://purl.obolibrary.org/obo/IAO_0000228> rdfs:label "term imported (IAO_0000228)"@en .
<http://purl.obolibrary.org/obo/IAO_0000229> rdfs:label "term split (IAO_0000229)"@en .
<http://purl.obolibrary.org/obo/IAO_0000227> rdfs:label "terms merged (IAO_0000227)"@en .
<http://purl.obolibrary.org/obo/OMO_0001000> rdfs:label "out of scope (OMO_0001000)"@en .


#### SHACL Groups for a nicer ordering of the form
termmeta4forms:EntityTypeGroup a sh:PropertyGroup ;
rdfs:label "Entity Type"@en ;
sh:order 1. 

termmeta4forms:LabelsGroup a sh:PropertyGroup ;
rdfs:label "Entity Labels"@en ;
sh:order 2 .

termmeta4forms:DefinitionGroup a sh:PropertyGroup ;
rdfs:label "Entity Definition"@en ;
sh:order 3 .

termmeta4forms:ObsoletionGroup a sh:PropertyGroup ;
rdfs:label "Term obsoletion"@en ;
sh:order 4. 

termmeta4forms:OtherTermAnnotationsShape a sh:PropertyGroup ;
rdfs:label "Other Term Annotations"@en ;
sh:order 5 .

termmeta4forms:EditorialMetadataGroup a sh:PropertyGroup ;
rdfs:label "Editorial Metadata"@en ;
sh:order 6 .
