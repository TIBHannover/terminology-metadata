@base <https://www.purl.org/termmetadata/shape4forms> .
@prefix termmeta: <https://www.purl.org/termmetadata/shape4forms> .
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>. 
@prefix dc: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix schema: <https://www.schema.org/> .
@prefix gndo: <https://d-nb.info/standards/elementset/gnd#> .
@prefix physh: <https://physh.org/rdf/2018/01/01/core#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oio: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix emmo: <http://emmo.info/emmo#> .
@prefix vann: <http://purl.org/vocab/vann/> .

# Term-level metadata

# if used in ULB Darmstadt's <shacl-form demo> blank nodes will be the subject of all statements generated with this shape - these should be replaced by an identifier in ALL occurrences 

termmeta:TermShape rdf:type sh:NodeShape , owl:Ontology ;
  sh:targetClass owl:Class, rdfs:Class, owl:ObjectProperty, owl:NamedIndividual, owl:AnnotationProperty, owl:DatatypeProperty ;
  sh:closed false;
  # add metadata

## Mandatory metadata

# 4.1.0 Typing the entity - only needed for forms

 sh:property [
   a sh:PropertyShape ;
   sh:name "entity type"@en ;
   sh:path rdf:type ;
   sh:nodeKind sh:IRI ;
   sh:minCount 1 ;
   sh:in (
    owl:Class 
    owl:NamedIndividual 
    owl:ObjectProperty 
    owl:AnnotationProperty 
    owl:DatatypeProperty
  ) ;
    sh:group termmeta:EntityTypeGroup ;
    sh:name "entity type"@en ;
    sh:description "The entity needs to be typed."@en ;
 ];

### 4.1.1 Preferred label

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "preferred label"@en ;
    sh:severity sh:Violation ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """The entity should have a label. The label should be the entity's preferred label. You should provide only one label per language. There may be a preferred label in each annotation language of the ontology, though."""@en ;
    sh:group termmeta:LabelsGroup ;
  ];

### 4.1.2 Definition

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "definition"@en ;
    sh:severity sh:Violation ;
    sh:path skos:definition ;
    sh:minCount 1;
    sh:datatype rdf:langString ;
    sh:uniqueLang true ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """The entity should be defined. The definition should be an intensional defintion. Please visit section 4.1.2 in the [metadata guide](<https://www.doi.org/10.5281/zenodo.11103071>) for more information about how to write a good definition. You will also find recommendations on how to provide sources for the definition in this chapter."""@en ;
    sh:group termmeta:DefinitionGroup ;
  ];

# alternative to the shape directoly above, do not want to use it for several reasons:
# (1) <shacl-form> demo will generate a statement with skos:definition and a blank node as its object
# (2) referencing the generated entity requires user to copypaste bnode id from generated code to form
# (3) since for the owl:Axiom a bnode like _:e45de023-010f-4c32-8d13-c38d02aa983c is generated, the definition is shown twice in the ontology - once readable with skos:definition and an annotation and once as an unreadable blank node ; to change this, the explicit definition statement needs to be removed to show this exactly as it would have been created with Protege
# (4) the code generated is not directly readable by Protege since the properties used are not  defined as annotationProperties and will not be displayed
# (5) all in all: too much work required afterwards to be explained by our recommendations > INSTEAD WE SHOULD RECOMMEND TO USE THE SHAPES FOR DEFINITION SOURCES SEPERATELY AFTER THE TERM SHAPE HAS BEEN USED
  # sh:property [
  #   rdf:type sh:PropertyShape ;
  #   sh:name "definition"@en ;
  #   sh:severity sh:Violation ;
  #   sh:path skos:definition ;
  #   sh:minCount 1;
  #   sh:node termmeta:DefinitionSourceAxiomShapeStyle1 ; 
  #   sh:description """The entity should be defined. The definition should be an intensional defintion. Please visit section 4.1.2 in the [metadata guide](<https://www.doi.org/10.5281/zenodo.11103071>) for more information about how to write a good definition. You will also find recommendations on how to provide sources for the definition in this chapter."""@en ;
  #   sh:group termmeta:DefinitionGroup ;
  # ];

## for definition source shapes see below (4.1.2.1)

### 4.1.3 Term deprecation/ obsoletion (mandatory only if applicable!)

### 4.1.3.1 Deprecation marker (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "is deprecated"@en ;
    sh:severity sh:Info ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:maxCount 1 ;
    sh:group termmeta:ObsoletionGroup ;
    sh:description """If the entitity shall be considered deprecated, please check the box."""@en
  ];

### 4.1.3.2 Obsoletion reason (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "obsoletion reason"@en ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0000231 ;
    sh:nodeKind sh:IRI ;
    sh:group termmeta:ObsoletionGroup ;
    sh:minCount 0 ; # mandatory only if applicable, minimal requirements is that it is one of the list items
    sh:in (
      <http://purl.obolibrary.org/obo/IAO_0000103>
      <http://purl.obolibrary.org/obo/IAO_0000226>
      <http://purl.obolibrary.org/obo/IAO_0000228>
      <http://purl.obolibrary.org/obo/IAO_0000229>
      <http://purl.obolibrary.org/obo/IAO_0000227>
      <http://purl.obolibrary.org/obo/OMO_0001000>
    );
    sh:description """If the entity was set to deprecated this field is mandatory. Please choose one of the list values to describe the reason for deprecating the entitiy. If none of them fit, you can also provide a deprecation reason with an rdfs:comment (see below)."""@en ;
  ];

### 4.1.3.3 Term replacement (mandatory only if applicable!)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "replaced by"@en ;
    sh:severity sh:Warning ;
    sh:path obo:IAO_0100001 ;
    sh:nodeKind sh:IRI ;
    sh:group termmeta:ObsoletionGroup ;
    sh:minCount 0 ; # mandatory only if applicable
    sh:description """If the entity is deprecated, please indicate if there is a replacement term that should be used instead."""@en
  ];

## 4.2 Recommended metadata

### 4.2.1 Synonyms/ alternative labels

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "synonyms/ alternative labels"@en ;
    sh:severity sh:Warning ;
    sh:path skos:altLabel ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Add further labels for the entities - may include synonyms, short forms and other alternative signifiers of the entity. Please only add strict synonyms, i.e. labels that represent the same concept as the preferred label. Do not add near-synonyms or related terms."""@en ;
    sh:group termmeta:LabelsGroup ;
  ];

### 4.2.2 Date modified

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "date modified"@en ;
    sh:severity sh:Warning ;
    sh:path dcterms:modified ;
    sh:minCount 1 ; # we recommend it and I would expect it on every item, so the aim of this constraint is to trigger a message at least to raise awareness
    sh:datatype xsd:dateTime ;
    sh:description """Add the current date to indicate that the entity is modified today."""@en ;
    sh:group termmeta:EditorialMetadataGroup ;
  ];

#### 4.2.3 Editor note

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "editor note"@en ;
    sh:severity sh:Warning ;
    sh:path skos:editorialNote ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Add an editorial note, e.g. stating an open task to finalize the description of the entity."""@en ;
    sh:group termmeta:EditorialMetadataGroup ;
  ] ;

#### 4.2.4 Term tracker item - datatype

# I would not necessarily expect a term tracker item for every term, so I did not add a minCoun 1 constraint with severity sh:Info
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ; 
    sh:name "term tracker item"@en ;
    sh:path obo:IAO_0000233 ;
    sh:nodeKind sh:IRI ;
    sh:description """Indicate a place where the entity is discussed and where new suggestions for its development can be made."""@en ;
    sh:group termmeta:EditorialMetadataGroup ;
  ];

## 4.3 Optional metadata

#### 4.3.1 Term editor/ term contributor(s)

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "term editor / term contributors"@en ;
    sh:severity sh:Warning ;
    sh:path dcterms:contributor ;
    sh:nodeKind sh:IRI ;
    sh:description """Provide all term contributors via their Orcid. If no Orcid is available, try alternative identifiers like GND, Wikidata, or other scientific identification systems."""@en ;
    sh:group termmeta:EditorialMetadataGroup ;
  ];

#### 4.3.2 Example of usage
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ;
    sh:name "example of usage"@en ;
    sh:path obo:IAO_0000112 ;
    sh:datatype rdf:langString ; # I'd prefer using text - could still be an iri as value
    sh:minCount 0 ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description """Describe how the entity can be applied. If the usage example is too complex, point to a paper or documentation for further discussion."""@en ;
    sh:group termmeta:OtherTermAnnotationsShape ;
  ];

# in a shape to be used with ULB Darmstadts form generator, I cannot use both > both shapes will validate each other invalid, and the sh:xone construct is not supported in a way that users can decide which data type to use and what to evaluate as valid afaik
#   sh:property [
#     rdf:type sh:PropertyShape ;
#     sh:severity sh:Warning ;
#     sh:name "example of usage - IRI"@en ;
#     sh:path obo:IAO_0000112 ;
#     sh:minCount 0 ;
#     sh:nodeKind sh:IRI ;
#     sh:description """"""@en ;
#   ];

#### 4.3.3 Defined by

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Warning ;
    sh:name "defined by"@en ;
    sh:path <http://www.w3.org/2000/01/rdf-schema#isDefinedBy>;
    sh:nodeKind sh:IRI ;
    sh:description """State the IRI of the ontology that defines the entity. The field can be repeated. For maximum precision, state both the canonical IRI of the defining ontology and its version IRI."""@en ;
    sh:group termmeta:EditorialMetadataGroup ;
  ];


#### 4.3.4 Comments

  sh:property [
    rdf:type sh:PropertyShape ;
    sh:name "comments"@en ;
    sh:severity sh:Warning ;
    sh:path rdfs:comment ;
    sh:datatype rdf:langString ;
    sh:description """Repeatable field to add any further comments on the entity."""@en ;
    sh:languageIn ("de" "en" "fr") ;
    sh:group termmeta:OtherTermAnnotationsShape ;
  ]
.

#### Labels for list values

<http://purl.obolibrary.org/obo/IAO_0000103> rdfs:label "failed exploratory term (IAO_0000103)"@en .
<http://purl.obolibrary.org/obo/IAO_0000226> rdfs:label "placeholder removed (IAO_0000226)"@en .
<http://purl.obolibrary.org/obo/IAO_0000228> rdfs:label "term imported (IAO_0000228)"@en .
<http://purl.obolibrary.org/obo/IAO_0000229> rdfs:label "term split (IAO_0000229)"@en .
<http://purl.obolibrary.org/obo/IAO_0000227> rdfs:label "terms merged (IAO_0000227)"@en .
<http://purl.obolibrary.org/obo/OMO_0001000> rdfs:label "out of scope (OMO_0001000)"@en .


#### SHACL Groups for a nicer ordering of the form
termmeta:EntityTypeGroup a sh:PropertyGroup ;
rdfs:label "Entity Type"@en ;
sh:order 1. 

termmeta:LabelsGroup a sh:PropertyGroup ;
rdfs:label "Entity Labels"@en ;
sh:order 2 .

termmeta:DefinitionGroup a sh:PropertyGroup ;
rdfs:label "Entity Definition"@en ;
sh:order 3 .

termmeta:ObsoletionGroup a sh:PropertyGroup ;
rdfs:label "Term obsoletion"@en ;
sh:order 4. 

termmeta:OtherTermAnnotationsShape a sh:PropertyGroup ;
rdfs:label "Other Term Annotations"@en ;
sh:order 5 .

termmeta:EditorialMetadataGroup a sh:PropertyGroup ;
rdfs:label "Editorial Metadata"@en ;
sh:order 6 .


##### 4.1.2.1 Definition source

# we offer a range of possibilities to provide definition sources; these need to be seperate node shapes
# they can be used seperately in <shacl-form> demo to generate instances of owl:Axiom that refer to existing entities
# usage with sh:node is not preferred, see 4.1.2 for reaons

## Style 1 with 'definition source' <http://purl.obolibrary.org/obo/IAO_0000119> + DOI

### Differs from TermShape.ttl since we want to generate data graphs that are as explicit as possible and not using blank nodes, which is unfortunately the case if we were to employ the shapes from TestShape.ttl
termmeta:DefinitionSourceAxiomShapeStyle1 rdf:type sh:NodeShape ;
  sh:targetClass owl:Axiom ;
  sh:closed false;
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Info ;
    sh:path owl:annotatedSource ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated source. This is the identifier of the entity whose definition source shall be added."@en ;
    rdfs:label "annotated source"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedTarget ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description "The definition source axiom must have exactly one annotated target. This is the exact text of the definition whose source shall be provided. The annotated target of the definition source axiom must be provided as an rdf:langString."@en ;
    rdfs:label "annotated target"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedProperty ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated property. This is the property used to provide your definitions - preferrably the recommended property skos:definition."@en ;
    rdfs:label "annotated property"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path <http://purl.obolibrary.org/obo/IAO_0000119> ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have at least one statement with the property \'definition source\' <http://purl.obolibrary.org/obo/IAO_0000119>. The source should be provided by a persistent identifier to the source, e.g. a DOI."@en ;
    rdfs:label "definition source"@en ;
  ];
  .

## Style 2 using DCMI Metadata Terms 

### Differs from TermShape.ttl since we want to generate data graphs that are as explicit as possible and not using blank nodes, which is unfortunately the case if we were to employ the shapes from TestShape.ttl
termmeta:DefinitionSourceAxiomShapeStyle2 rdf:type sh:NodeShape ;
  sh:targetClass owl:Axiom ;
  sh:closed false;
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedSource ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated source. This is the identifier of the entity whose definition source shall be added."@en ;
    rdfs:label "annotated source"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedTarget ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description "The definition source axiom must have exactly one annotated target. This is the exact text of the definition whose source shall be provided. The annotated target of the definition source axiom must be provided as an rdf:langString."@en ;
    rdfs:label "annotated target"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedProperty ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated property. This is the property used to provide your definitions - preferrably the recommended property skos:definition."@en ;
    rdfs:label "annotated property"@en ;
  ];
  sh:property [
    sh:path <http://purl.org/dc/terms/bibliographicCitation> ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/bibliographicCitation>. The object of that statement must be provided as an xsd:string."@en ;
    rdfs:label "bibliographic citation"@en ;
  ];
  sh:property [
    sh:path <http://purl.org/dc/terms/license>;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/license>. The object of that statement must be provided as an sh:IRI."@en ;
    rdfs:label "license"@en ;
  ];
  sh:property [
    sh:path <http://purl.org/dc/terms/rightsHolder>;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/rightsHolder>. The object of that statement must be provided as an sh:IRI, e.g. via a ROR identifier."@en ;
    rdfs:label "rights holder"@en ;
  ];
  sh:property [
    sh:path <http://purl.org/dc/terms/source>;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:description "The definition source axiom must have a statement with <http://purl.org/dc/terms/source>. The object of that statement must be provided as an sh:IRI, e.g. via a DOI."@en ;
    rdfs:label "source"@en ;
  ];
.

## Style 3 + 4 - using prov:hadPrimarySource + DOI or ORCID

### Differs from TermShape.ttl since we want to generate data graphs that are as explicit as possible and not using blank nodes, which is unfortunately the case if we were to employ the shapes from TestShape.ttl
termmeta:DefinitionSourceAxiomShapeStyle3and4 rdf:type sh:NodeShape ;
  sh:targetClass termmeta:DefinitionSourceAxiomShapeStyle3and4 ;
  sh:closed false;
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedSource ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated source. This is the identifier of the entity whose definition source shall be added."@en ;
    rdfs:label "annotated source"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedTarget ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype rdf:langString ;
    sh:languageIn ("en" "de" "fr") ; # add more # only needed for forms or if test shall be very restrictive
    sh:description "The definition source axiom must have exactly one annotated target. This is the exact text of the definition whose source shall be provided. The annotated target of the definition source axiom must be provided as an rdf:langString."@en ;
    rdfs:label "annotated target"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path owl:annotatedProperty ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have exactly one annotated property. This is the property used to provide your definitions - preferrably the recommended property skos:definition."@en ;
    rdfs:label "annotated property"@en ;
  ];
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:severity sh:Violation ;
    sh:path prov:hadPrimarySource ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:description "The definition source axiom must have at least one statement with <http://www.w3.org/ns/prov#hadPrimarySource>. The object of <http://www.w3.org/ns/prov#hadPrimarySource> in the definition source axiom must be provided as an sh:IRI. If you want to refer to a publication, use the DOI, if you want to refer to an expert, use the ORCID."@en ;
    rdfs:label "had primary source"@en ;
  ] ;
.
